      "link": null,
      "locked": false,
      "text": "原码： 正号用0表示，负号用1表示，数值部分不变",
      "fontSize": 20.311110432942698,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "原码： 正号用0表示，负号用1表示，数值部分不变",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BMo77OwIRHfSh2X7CDgLp",
      "type": "text",
      "x": 541.0484797413033,
