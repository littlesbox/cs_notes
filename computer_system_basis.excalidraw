      "link": null,
      "locked": false,
      "text": "这里使用的是规格化的尾数，小数点后开头要是1，否则应该调整的是阶数",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "这里使用的是规格化的尾数，小数点后开头要是1，否则应该调整的是阶数",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
