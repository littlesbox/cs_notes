      "link": null,
      "locked": false,
      "text": "SupIDoer是java中间层在\nrocket.chat中对应的账号",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "R-7zDcqJABVle8CdQrtnM",
      "originalText": "SupIDoer是java中间层在rocket.chat中对应的账号",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jpbUyXdMwspvWqcq-8u0X",
      "type": "stickynote",
      "x": 1786.5552970412189,
      "y": 8794.399652262022,
      "width": 250,
      "height": 352,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffdf6b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
