      "type": "text",
      "x": 255.77372998544388,
      "y": 1201.3931282755163,
      "width": 590.6921385047436,
      "height": 92.76069007762878,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
