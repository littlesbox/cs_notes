      "updated": 1792333242623,
      "created": 1792312498368,
      "link": null,
      "locked": false,
      "text": "移码： 将每一个数值加上一个偏置常数，\nn位移码中，移码=真值+2^(n-1)",
      "fontSize": 20.311110432942698,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "移码： 将每一个数值加上一个偏置常数，\nn位移码中，移码=真值+2^(n-1)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
