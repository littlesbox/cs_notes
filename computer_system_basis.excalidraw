      "version": 1087,
      "versionNonce": 651776439,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "OIMmDKKMv32b5rcTsJ9qj",
          "type": "arrow"
        }
      ],
      "updated": 1792335032951,
      "created": 1792311539597,
      "link": null,
      "locked": false,
      "text": "X = (-1) * M * R",
      "fontSize": 74.20855206210301,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X = (-1) * M * R",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JOGjI7Bx_GpOBFEbxD-pE",
      "type": "text",
      "x": 518.3530231328089,
