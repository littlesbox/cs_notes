    {
      "id": "BHZi27wwLAfFIHTbJ2wT6",
      "type": "text",
      "x": 508.4400507862247,
      "y": 2200.6042147372664,
      "width": 679.625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "0HT5fqdl1H9MZAiIBA4rM"
      ],
      "frameId": null,
      "index": "b8T",
      "roundness": null,
      "seed": 2096631575,
      "version": 435,
      "versionNonce": 1373841017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792335560262,
      "created": 1792332575030,
      "link": null,
      "locked": false,
      "text": "原码小数表示尾数\n规格化尾数的小数点后第一位总是1，可以规定第一位默认的1不明显表示出来\n这样可用23个数位表示24位尾数",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "原码小数表示尾数\n规格化尾数的小数点后第一位总是1，可以规定第一位默认的1不明显表示出来\n这样可用23个数位表示24位尾数",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xcJKQA7XJkJbjTLJBHgVs",
      "type": "text",
      "x": 239.77348584481842,
      "y": 2341.6042452548445,
      "width": 520.5750122070312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8h",
      "roundness": null,
      "seed": 868156663,
      "version": 177,
      "versionNonce": 545910969,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792333969151,
      "created": 1792333898112,
      "link": null,
      "locked": false,
      "text": "最大正数： 0.111...1 * 2^(1111..1) = (1-2^(-24)) * 2^127",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "最大正数： 0.111...1 * 2^(1111..1) = (1-2^(-24)) * 2^127",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IYyPiqAMt1CkMtmKZ7c4b",
      "type": "text",
      "x": 242.48591870614655,
      "y": 2400.9375582431257,
      "width": 483.5249938964844,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8i",
      "roundness": null,
      "seed": 1065068951,
      "version": 311,
      "versionNonce": 1661190135,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792334019830,
      "created": 1792333970655,
      "link": null,
      "locked": false,
      "text": "最小正数： 0.100...0 * 2^(00..0) = (1/2) * 2^-128",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "最小正数： 0.100...0 * 2^(00..0) = (1/2) * 2^-128",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
