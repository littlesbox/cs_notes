      "width": 28.21947960450691,
      "height": 49.682183069633545,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1wjd69XxrUiBgdts45qOH"
      ],
      "frameId": null,
      "index": "b7t",
